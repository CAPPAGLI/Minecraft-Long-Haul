{"client_side": "optional", "server_side": "required", "game_versions": ["1.18.2", "1.19.3", "1.19.4", "1.20", "1.20.1", "1.20.2", "1.20.4", "1.20.6", "1.21", "1.21.1", "1.21.10", "1.21.11", "1.21.3", "1.21.4", "1.21.5", "1.21.6", "1.21.7", "1.21.8", "26.1", "26.1.1", "26.1.2", "26.2", "26.3"], "environment": ["server_only_client_optional"], "id": "cl223EMc", "slug": "cristel-lib", "project_type": "mod", "team": "jQLbV11P", "organization": null, "title": "Cristel Lib", "description": "A Library mod for easy structure config and runtime datapacks.", "body": "# Cristel Lib\n\nCristel Lib is a lightweight library mod that makes it easy to create and manage structure configs — through code or data.\nIt’s built for flexibility, giving players, modpack creators, and developers full control over how structures generate and behave.\n\n## For Players\n\n* Customize structure generation for any supported mod.\n* Adjust world generation to fit your personal playstyle.\n\n## For Modpack Creators\n\n* Create custom structure configs or override existing ones.\n* Disable unwanted structure configs entirely.\n* Use the `<mod_id>@<config_name>` format to link your configs to specific mods. <br>Learn more [here](https://github.com/Cristelknight999/Cristel-Lib/wiki/2.-Creating-a-structure-config#for-modpack-makers-advanced).\n\n## For Mod Developers\n\n* Define structure configs for your mod.\n* Add internal configs directly in Java.\n* Automatically generate config screens (optional).\n* Load datapacks conditionally on Fabric and Forge.\n* Use runtime datapacks to add or modify data dynamically in-game.\n\n**How to do that? [Here](https://github.com/Cristelknight999/Cristel-Lib/wiki/1.-Getting-started) is a small tutorial.**\n\n---\n\nCurrently this mod is utilized by [WWEE](https://modrinth.com/mod/expanded-ecosphere), [Towns and Towers](https://modrinth.com/mod/towns-and-towers), [Explorify](https://modrinth.com/datapack/explorify)  and [Terralith](https://modrinth.com/mod/terralith)!\n", "body_url": null, "published": "2023-05-01T17:37:55.454619Z", "updated": "2026-09-19T14:48:25.657302Z", "approved": "2023-05-03T03:12:12.233159Z", "queued": "2023-05-01T18:49:30.105341Z", "status": "approved", "requested_status": "approved", "moderator_message": null, "license": {"id": "CC-BY-NC-ND-4.0", "name": "Creative Commons Attribution Non Commercial No Derivatives 4.0 International", "url": "https://creativecommons.org/licenses/by-nc-nd/4.0/"}, "downloads": 19481652, "followers": 1164, "categories": ["library", "worldgen"], "additional_categories": ["cursed"], "loaders": ["fabric", "forge", "neoforge", "quilt"], "versions": ["qyBhDCjL", "QbWRJZhp", "qTUoNGY9", "BeiojRZG", "rGfmEx0B", "J0jTgCIB", "HocdgthH", "pLuCu0Ka", "FsQL6FXV", "U859rPyK", "y3Ko1fGT", "LlLYE55K", "sc0QxThr", "TRoJ8Yc4", "wSQEXFVB", "VGzwSAM8", "FGDF6byY", "vwJk3fWs", "k0RzoTGC", "BNcnK1k5", "LRFIdFuW", "amI1oyGG", "tBnivdbu", "rXMG4HtT", "HiLmugPC", "fANI0ba4", "LOGne5BJ", "oTRDEoMt", "QzhenNWE", "9e6KHhU3", "3aypqSNl", "ElM4X70m", "jMYaXwo6", "QKpglnFb", "LXyrdywi", "VjaAEPBl", "V8kulhC0", "oLp2OCg3", "8iGbvXwk", "DOsSK4NK", "oT04jpll", "pcnAJaO5", "ADKSOV3O", "Z4HqO4Am", "T2JWurbR", "sILGNCx4", "nvBbYALa", "waCffck8", "TF0bB1VS", "bgdjh4pG", "dTKknjtx", "WEUgcqrr", "2pbgbLQi", "eSjGT41i", "JwzGxSzH", "wEUhAqMj", "VEOx5uG8", "3d4XeMfd", "pRNiTy0y", "BLa9dOnj", "a2knYCon", "fpeYegvZ", "UfivGGmq", "oFrnFrNm", "7Ntp9dD3", "ZvMKpvgf", "K2pVXHCe", "z86zTl4X", "6vtzWpRI", "JiCAbUWP", "h5nfApnW", "q4ANRUMZ", "QW7dcPGu", "pFmaiGvS", "p21e0kLQ", "gJe55Neh", "yWdD26Oh", "HhcCCbE2", "1k0Rv30o", "MRyvygQV", "GBVtWlUN", "PKOCWiGJ", "bDd8Xl0w", "JbGjwnV6", "BRVWgniI", "GlBkE8Zq", "5Skaj6dw", "Sduz0AWP", "K1dyr5gj", "rhpKhWXb", "1NM741mO", "ofxpupA4", "1yyRhsti", "OoKByyJE", "bWDW9ZQ9", "YrhjS3HR", "nyrGV1GK", "Yp0XKKMq", "A4jiHA7w", "xNJVQZkW", "B50feQkV", "8CVrcGex", "8049CnMl", "rcSodUE0", "bociZXpN", "QLCbh6Ql", "iNFZUYRZ", "rVwhMA5a", "9p2TokHI", "FuH9KtJD", "8o19Ot4V", "WWbbl4Rn", "JDTs3e